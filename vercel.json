{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/((?!bloqueado).*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(HTTrack|httrack|Wget|wget|WebCopier|WebZIP|Web Downloader|Offline Explorer|Teleport|SiteSucker|WebReaper|WebStripper|WebSauger|WebWhacker|WebCapture|Website Downloader|SiteSnagger|BlackWidow|Scrapy|scrapy|python-requests|Python-urllib|aiohttp|libwww-perl|PhantomJS).*"
        }
      ],
      "destination": "/bloqueado",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)\\.webp",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ]
}
